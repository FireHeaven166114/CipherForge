# CipherForge environment template.
#
# Copy this file to `.env` and adjust it. `.env` is git-ignored.
# Everything below is a PLACEHOLDER - never commit real credentials.
#
# Docker Compose reads this file for variable substitution, and the backend
# also reads it when you run it directly on your machine.

# --- Runtime ------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json (structured, for log pipelines) | console (human friendly)
LOG_FORMAT=console

# --- Authentication -----------------------------------------------------
# dev   : no sign-in; every request is a fixed local principal.
#         The API REFUSES TO START with AUTH_MODE=dev when ENVIRONMENT=production.
# entra : validate Microsoft Entra ID access tokens (set the three values below).
AUTH_MODE=dev
# Roles granted to the local dev principal (comma separated):
# Admin, SecurityAnalyst, User
DEV_AUTH_ROLES=SecurityAnalyst
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Optional. Defaults to ENTRA_CLIENT_ID (v2.0 access tokens).
ENTRA_AUDIENCE=

# --- Database -----------------------------------------------------------
# Used by the `postgres` container in docker-compose.yml, which also builds the backend's
# DATABASE_URL from these three values. Because the password is placed inside a URL, use only
# letters and digits. Generate one with:  openssl rand -hex 24
# The backend refuses to start with ENVIRONMENT=production while this still says CHANGE_ME.
POSTGRES_USER=cipherforge
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=cipherforge

# Used only when the backend runs directly on your machine (outside Compose).
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql+psycopg://cipherforge:CHANGE_ME_local_only@localhost:5432/cipherforge

# --- Docker Compose: published ports ------------------------------------
# All three are bound to 127.0.0.1 only. Change them if the port is already in use.
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# --- Browser access (CORS) ----------------------------------------------
# Comma separated origins allowed to call the API cross-origin.
# Leave empty when the frontend is served same-origin (Compose/nginx or the Vite proxy).
CORS_ORIGINS=
